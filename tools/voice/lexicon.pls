<?xml version="1.0" encoding="UTF-8"?>
<!-- The pronunciation list for tools/voice/voice.mjs: an alias replaces the written word in what the
     voice is asked to say (the subtitle keeps the written word). A changed alias makes every line
     with that word a new clip on the next `make voice`. Add a lexeme when a take gets a name wrong. -->
<lexicon version="1.0" xmlns="http://www.w3.org/2005/01/pronunciation-lexicon" alphabet="ipa" xml:lang="sv-SE">
  <lexeme><grapheme>Škoda</grapheme><alias>Skoda</alias></lexeme>
  <lexeme><grapheme>Škodan</grapheme><alias>Skodan</alias></lexeme>
  <lexeme><grapheme>P-Ordning</grapheme><alias>Pe-ordning</alias></lexeme>
  <lexeme><grapheme>p-skiva</grapheme><alias>pe-skiva</alias></lexeme>
</lexicon>
